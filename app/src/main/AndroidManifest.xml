<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 파일은 시스템 파일 선택기(SAF)로 열고 저장한다. 인터넷 권한은 없다(DeepL 은 DeepL 앱을 직접 연다).
         '모든 파일 접근'은 원본 백업(원본 폴더 안에 vtt 폴더 만들기)에만 쓰고, 설정 탭에서 끌 수 있다. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 안드로이드 11+ 에서 DeepL 앱이 설치돼 있는지 보고 열기 위해 필요 -->
    <queries>
        <package android:name="com.deepl.mobiletranslator" />
    </queries>

    <application
        android:label="자막 다듬기"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
